KONFID_ENV=development
KONFID_DATABASE_URL=sqlite:///./konfid.db
KONFID_DEV_MODE=true
KONFID_DEV_SIGNING_SECRET=dev-only-change-this-secret-1234567890
KONFID_WORKLOAD_ISSUER=konfid-dev
KONFID_WORKLOAD_AUDIENCE=konfid-api
KONFID_ACTOR_ISSUER=konfid-identity-dev
KONFID_ACTOR_AUDIENCE=konfid-actor
KONFID_REQUIRE_ACTOR_ASSERTION=false
KONFID_POLICY_MODE=local
KONFID_KOA_POLICY_URL=
KONFID_KOA_AUDIT_URL=
KONFID_INTERACTION_KERNEL_URL=
KONFID_ORGO_URL=
# Optional outbound auth injected by the deployment/runtime; prefer short-lived workload tokens.
KONFID_KOA_POLICY_BEARER_TOKEN=
KONFID_KOA_AUDIT_BEARER_TOKEN=
KONFID_INTERACTION_KERNEL_BEARER_TOKEN=
KONFID_ORGO_BEARER_TOKEN=
KONFID_ORGO_ORGANIZATION_ID=
KONFID_ORGO_CASE_LABEL=1.11.Konfid
