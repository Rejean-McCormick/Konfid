# Konfid production template. Prefer *_FILE variables mounted from a secret
# manager over literal bearer tokens. Never commit real credentials.
KONFID_ENV=production
KONFID_DEV_MODE=false
KONFID_INSTANCE_ID=konfid-prod-1
KONFID_DATABASE_URL=postgresql+psycopg://konfid:REPLACE_ME@postgres.internal:5432/konfid?sslmode=verify-full
KONFID_DATABASE_POOL_SIZE=20
KONFID_DATABASE_MAX_OVERFLOW=20
KONFID_DATABASE_POOL_TIMEOUT_SECONDS=5
KONFID_DATABASE_POOL_RECYCLE_SECONDS=600
KONFID_DATABASE_STATEMENT_TIMEOUT_MS=5000
KONFID_DATABASE_LOCK_TIMEOUT_MS=2000
KONFID_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
KONFID_REQUIRE_SCHEMA_HEAD=true

# HTTP surface
KONFID_TRUSTED_HOSTS='["konfid.internal"]'
KONFID_CORS_ORIGINS='[]'
KONFID_MAX_REQUEST_BODY_BYTES=1048576
KONFID_DOCS_ENABLED=false
KONFID_HSTS_SECONDS=31536000
KONFID_METRICS_ENABLED=true
KONFID_METRICS_TOKEN_FILE=/run/secrets/konfid_metrics_token

# Workload identities (service -> Konfid)
KONFID_WORKLOAD_ISSUER=https://identity.example/workloads
KONFID_WORKLOAD_AUDIENCE=konfid-api
KONFID_WORKLOAD_JWKS_URL=https://identity.example/workloads/.well-known/jwks.json
KONFID_WORKLOAD_ALGORITHMS='["RS256","ES256","EdDSA"]'
KONFID_WORKLOAD_MAX_TOKEN_TTL_SECONDS=900

# Human actor assertions normalized by kOA Identity & Trust
KONFID_ACTOR_ISSUER=https://identity.example/actors
KONFID_ACTOR_AUDIENCE=konfid-actor
KONFID_ACTOR_JWKS_URL=https://identity.example/actors/.well-known/jwks.json
KONFID_ACTOR_ALGORITHMS='["RS256","ES256","EdDSA"]'
KONFID_ACTOR_MAX_TOKEN_TTL_SECONDS=600
KONFID_JWT_CLOCK_SKEW_SECONDS=30
KONFID_REQUIRE_ACTOR_ASSERTION=true
KONFID_REQUIRE_ACTOR_AUTHORIZED_PARTY=true

# Production policy authority
KONFID_POLICY_MODE=koa
KONFID_KOA_POLICY_URL=https://koa-policy.internal
KONFID_KOA_POLICY_BEARER_TOKEN_FILE=/run/secrets/koa_policy_token

# Authoritative audit export
KONFID_KOA_AUDIT_URL=https://koa-audit.internal
KONFID_KOA_AUDIT_BEARER_TOKEN_FILE=/run/secrets/koa_audit_token

# Typed privileged enforcement transport
KONFID_INTERACTION_KERNEL_URL=https://interaction-kernel.internal
KONFID_INTERACTION_KERNEL_BEARER_TOKEN_FILE=/run/secrets/interaction_kernel_token

# Human workflow (optional; approval authority remains Konfid)
KONFID_ORGO_URL=https://orgo.internal
KONFID_ORGO_BEARER_TOKEN_FILE=/run/secrets/orgo_token
KONFID_ORGO_ORGANIZATION_ID=REPLACE_ME
KONFID_ORGO_CASE_LABEL=1.11.Konfid

# Outbound TLS. Use a private CA bundle when internal services are private PKI.
KONFID_OUTBOUND_CA_BUNDLE=/run/secrets/internal_ca.pem
# Optional mTLS instead of / in addition to bearer credentials.
# KONFID_OUTBOUND_CLIENT_CERT_FILE=/run/secrets/konfid-client.crt
# KONFID_OUTBOUND_CLIENT_KEY_FILE=/run/secrets/konfid-client.key
KONFID_HTTP_CONNECT_TIMEOUT_SECONDS=2
KONFID_HTTP_READ_TIMEOUT_SECONDS=5
KONFID_HTTP_WRITE_TIMEOUT_SECONDS=5
KONFID_HTTP_POOL_TIMEOUT_SECONDS=2
KONFID_HTTP_MAX_RESPONSE_BYTES=2097152
KONFID_HTTP_RETRY_ATTEMPTS=3
KONFID_HTTP_CIRCUIT_FAILURE_THRESHOLD=5
KONFID_HTTP_CIRCUIT_RESET_SECONDS=30

# Abuse controls
KONFID_RATE_LIMIT_ENABLED=true
KONFID_RATE_LIMIT_DEFAULT_PER_MINUTE=600
KONFID_RATE_LIMIT_ADMIN_PER_MINUTE=120
KONFID_RATE_LIMIT_RESPONSE_PER_MINUTE=60
KONFID_RATE_LIMIT_ACCESS_PER_MINUTE=3000
KONFID_RATE_LIMIT_TELEMETRY_PER_MINUTE=10000

# Security workflow / durable workers
KONFID_DEFAULT_APPROVAL_TTL_SECONDS=900
KONFID_RISK_SIGNAL_TTL_SECONDS=900
KONFID_RESPONSE_ACTION_TTL_SECONDS=1800
KONFID_OUTBOX_MAX_ATTEMPTS=12
KONFID_OUTBOX_LEASE_SECONDS=60
KONFID_AUDIT_EXPORT_LEASE_SECONDS=60
KONFID_AUDIT_EXPORT_BATCH_SIZE=100
KONFID_WORKER_BATCH_SIZE=50
KONFID_WORKER_INTERVAL_SECONDS=1
